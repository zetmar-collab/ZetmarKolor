#include <winver.h>
#include "version.h"

// Opis wtyczki (PiPL) w formacie JSON, odczytywany przez Photoshopa/Elements z zasobow DLL.
JSON_PIPL JSON "pipl.json"

// Klasyczny PIPL (generowany z kodu: tools/make_pipl.cpp) - dla programow, ktore nie czytaja JSON (np. Affinity).
16000 PIPL "zk.pipl"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ZK_VER_COMMA
 PRODUCTVERSION ZK_VER_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Zetmar - Cyfrowy Przyjaciel"
            VALUE "FileDescription", "Kolor (krzywe, czern-biel, LUT, toning) - filtr dla Photoshop Elements i Photoshopa"
            VALUE "FileVersion", ZK_VER_STR
            VALUE "InternalName", "ZetmarKolor"
            VALUE "OriginalFilename", "ZetmarKolor_64.8bf"
            VALUE "ProductName", "Kolor (krzywe, LUT, toning)"
            VALUE "ProductVersion", ZK_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
